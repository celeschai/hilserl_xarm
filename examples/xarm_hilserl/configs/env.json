{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "xarm",
      "id": "xarm7",
      "ip": "192.168.1.235",
      "max_linear_speed_mm_s": 200.0,
      "max_linear_acc_mm_s2": 2000.0,
      "home_joint_speed_deg_s": 30.0,
      "gripper_open_pos": 800,
      "gripper_close_pos": 0,
      "gripper_speed": 5000,
      "random_xy_range_m": 0.0,
      "cameras": {
        "wrist": {
          "type": "intelrealsense",
          "serial_number_or_name": "134322070906",
          "width": 640,
          "height": 480,
          "fps": 30
        },
        "side": {
          "type": "intelrealsense",
          "serial_number_or_name": "261122273645",
          "width": 640,
          "height": 480,
          "fps": 30
        }
      }
    },
    "teleop": {
      "type": "spacemouse",
      "use_gripper": true,
      "deadzone": 0.05,
      "scale": 1.0,
      "axis_mapping": [
        "x",
        "y",
        "z"
      ]
    },
    "processor": {
      "control_mode": "spacemouse",
      "max_gripper_pos": 1.0,
      "observation": {
        "display_cameras": false,
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": false,
        "add_ee_pose_to_observation": false
      },
      "image_preprocessing": {
        "crop_params_dict": {
          "observation.images.wrist": [103, 261, 375, 379],
          "observation.images.side": [135, 181, 299, 339]
        },
        "resize_size": [128, 128]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": [
          65.29,
          -21.95,
          44.04,
          36.9,
          21.19,
          52.5,
          4.43
        ],
        "reset_time_s": 5.0,
        "control_time_s": 90.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": null,
        "target_frame_name": null,
        "end_effector_bounds": {
          "min": [
            -0.3409,
            0.2151,
            0.0657
          ],
          "max": [
            0.0058,
            0.5081,
            0.247
          ]
        },
        "end_effector_step_sizes": {
          "x": 0.01,
          "y": 0.01,
          "z": 0.01
        },
        "delta_reference": "measured"
      },
      "reward_classifier": {
        "pretrained_path": "outputs/train/xarm7_reward_classifier_v2/checkpoints/last/pretrained_model",
        "success_threshold": 0.5,
        "success_reward": 1.0
      }
    }
  },
  "dataset": {
    "repo_id": "local/xarm7_hilserl_demos",
    "root": null,
    "task": "Describe the task here",
    "num_episodes_to_record": 20,
    "replay_episode": null,
    "push_to_hub": false
  },
  "mode": null,
  "device": "cuda"
}
